# =====================================================================
# GOVERNMENT EXAM SHORTS AUTOMATION - ENVIRONMENT CONFIGURATION
# =====================================================================

# ---------------------------------------------------------------------
# YOUTUBE DATA API v3 (OAuth 2.0 Client Credentials)
# ---------------------------------------------------------------------
# 1. Create a project at https://console.cloud.google.com/
# 2. Enable "YouTube Data API v3"
# 3. Create OAuth 2.0 Client ID (Application type: Desktop App)
# 4. Download JSON and save as 'client_secrets.json' in project root
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=youtube_token.json

# ---------------------------------------------------------------------
# META GRAPH API (Facebook Reels for Pages)
# ---------------------------------------------------------------------
# 1. Create an App on https://developers.facebook.com/
# 2. Add 'Facebook Pages API' and request permissions:
#    - pages_show_list
#    - pages_read_engagement
#    - pages_manage_posts
# 3. Generate a Long-Lived Page Access Token from Graph API Explorer
META_PAGE_ID=your_facebook_page_id_here
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
META_GRAPH_API_VERSION=v19.0

# ---------------------------------------------------------------------
# VIDEO & PIPELINE DEFAULTS
# ---------------------------------------------------------------------
DEFAULT_VIDEO_DURATION=15.0
DEFAULT_FPS=30
AUDIO_TARGET_DB=-18.0
STAGGERED_INTERVAL_HOURS=4.0
